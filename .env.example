# Application mode: "test" or "production" ("prod" also accepted)
APP_MODE=test

# Database engine: mysql (primary deployment) or sqlite (rollback path)
DB_ENGINE=mysql

# MySQL connection — fill in real credentials in your local .env only.
# NEVER commit .env to Git.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# Per-environment database names (explicit APP_MODE mapping):
#   APP_MODE=test       -> TEST_DB_NAME
#   APP_MODE=production -> PROD_DB_NAME
TEST_DB_NAME=adaptive_diabetes_test
PROD_DB_NAME=adaptive_diabetes_prod

# Model artifacts (leakage-safe final experiment) — optional overrides
# THESIS_DIR=D:\MSc\BRFSS_Diabetes_Thesis
# DIABETES_MODEL_DIR=D:\MSc\BRFSS_Diabetes_Thesis\results\ml\results_leakage_safe
# PREPROCESSOR_PATH=D:\path\to\leakage_safe_preprocessor.joblib
# MODEL_PATH=D:\path\to\leakage_safe_logistic_regression.joblib
# SELECTED_FEATURES_PATH=D:\path\to\final_selected_features.csv

# Deployment threshold (validation-selected): 0.63 = max F1, 0.465 = >=80% recall
# DIABETES_THRESHOLD=0.63
