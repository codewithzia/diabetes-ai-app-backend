# Application mode: "test" or "production" ("prod" also accepted)
APP_MODE=test

# Database engine: mysql (primary deployment) or sqlite (rollback path)
DB_ENGINE=mysql

# MySQL connection — fill in real credentials in your local .env only.
# NEVER commit .env to Git.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# Per-environment database names (explicit APP_MODE mapping):
#   APP_MODE=test       -> TEST_DB_NAME
#   APP_MODE=production -> PROD_DB_NAME
TEST_DB_NAME=adaptive_diabetes_test
PROD_DB_NAME=adaptive_diabetes_prod

# Override model artifact paths if needed (optional)
# THESIS_DIR=D:\MSc\BRFSS_Diabetes_Thesis
# PREPROCESSOR_PATH=D:\path\to\brfss_preprocessor_final.joblib
# MODEL_PATH=D:\path\to\model.joblib
# SELECTED_FEATURES_PATH=D:\path\to\selected_feature_names.csv
